# Pinned godot-native-rl release used by the course game project.
#
# The addon's native libraries are not committed — they are larger than the rest
# of this repository combined. Install them with:
#
#     scripts/fetch-native-runner.sh
#
# and check what is currently installed with:
#
#     scripts/fetch-native-runner.sh --check
#
# To move to a newer release, bump release_tag and addon_sha256 together. The
# checksum is published as SHA256SUMS.txt on the release.

source_repo=minigraphx/godot-native-rl
release_tag=v0.4.0
addon_asset=godot-native-rl-addon-v0.4.0.zip
addon_sha256=803cd0bb8bb57ba1d58b36e03be97bbea6332177235b1fee0615033c8d2d208e

# Platforms shipped by this release
platform_scope=macos_arm64,windows_x86_64,linux_x86_64,ios,android,web_wasm32

# Minimum Godot version required by the GDExtension
godot_minimum=4.5
